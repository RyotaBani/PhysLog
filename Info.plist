<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  このファイルは Xcode が自動生成する Info.plist と「マージ」されます。
	  （GENERATE_INFOPLIST_FILE = YES と INFOPLIST_FILE の併用）
	  基本キーはここに書く必要がなく、ビルド設定で表現できないものだけを置いています。
	-->

	<!--
	  AdMob の App ID。ユニットIDではなくアプリIDなので区切りは「~」です。
	  間違えると起動直後に GADInvalidInitializationException で落ちます。
	  本番の App ID を設定済み。DEBUG ビルドでは AdConfig 側の分岐により
	  常にテスト用の広告ユニットが使われるため、開発中に本番広告は出ません。
	-->
	<key>GADApplicationIdentifier</key>
	<string>ca-app-pub-5619606203492593~5658384269</string>

	<!-- ATT ダイアログの説明文。曖昧な文言は審査で差し戻されます。 -->
	<key>NSUserTrackingUsageDescription</key>
	<string>アプリを無料で提供し続けるため、あなたに関連性の高い広告を表示する目的で使用します。許可しなくてもすべての機能をご利用いただけます。</string>

	<!-- ヘルスケアの読み取り理由。 -->
	<key>NSHealthShareUsageDescription</key>
	<string>体重・体脂肪率・睡眠時間を読み込み、手入力なしで記録を続けられるようにします。読み込んだデータは端末内にのみ保存され、外部へ送信されることはありません。</string>

	<!--
	  書き込みは行いません（requestAuthorization の toShare は空）が、
	  HealthKit の entitlement は読み取りと書き込みを区別しないため、
	  この文字列がないとアップロードが ITMS-90683 で弾かれます。
	  実態に反する説明は書かず、書き込まない旨をそのまま記載しています。
	-->
	<key>NSHealthUpdateUsageDescription</key>
	<string>PhysLog はヘルスケアへデータを書き込みません。体重・体脂肪率・睡眠時間の読み込みのみを行います。</string>

	<!--
	  PhotosPicker 自体は許可不要ですが、PhotosUI をリンクすると
	  Photos.framework の参照が入り、同じチェックに引っかかる可能性があるため
	  予防的に記載しています。
	-->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>体組成計の結果用紙やアプリ画面のスクリーンショットを読み取り、測定値を自動で入力するために使用します。画像は端末内で処理され、外部へ送信されることはありません。</string>

	<!--
	  SKAdNetwork（広告効果測定）の識別子。最低限 Google の識別子が必要です。
	  収益を最大化したい場合は Google 公式ドキュメントの全リストを追加してください。
	-->
	<key>SKAdNetworkItems</key>
	<array>
		<dict>
			<key>SKAdNetworkIdentifier</key>
			<string>cstr6suwn9.skadnetwork</string>
		</dict>
	</array>
</dict>
</plist>
